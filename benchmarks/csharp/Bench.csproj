<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# original's side of examples/bench: the same operations through CosmoUsb. COSMOUSB points at its
       src/CosmoUsb/CosmoUsb.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(COSMOUSB)" />
  </ItemGroup>
</Project>
