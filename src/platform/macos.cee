// macOS: IOKit's IOUSBLib user client for I/O, the IORegistry for enumeration, IOKit notifications for hotplug,
// one CFRunLoop thread for completions.
//
// Against the C# backend:
// - Enumeration copies each device's registry properties once (IORegistryEntryCreateCFProperties) and reads them
//   from the dictionary, instead of ~15 IORegistryEntrySearchCFProperty calls per device, each walking the
//   registry, behind a lock-guarded key cache.
// - Opening a device finds its service with IORegistryEntryIDMatching, one lookup, instead of iterating every
//   USB device in the system.
// - Control transfers are synchronous DeviceRequestTO calls: no run-loop round trip, no heap request record, no
//   GCHandle, no TransferQueue. The device needs no async event source at all.
// - Pipe completions find their slot from the callback's refcon, which is the slot itself.
// - Teardown is safe without deferring to a thread pool: removing a source is followed by a barrier through the
//   run loop (our own version-0 source), after which no callout of the removed source can still be running.
// - The run loop always has the barrier source, so it never exits for want of sources (the C# loop slept 10 ms
//   and retried).

@header("usb_os.h")
extern "C" {
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRelease(cf: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRetain(cf: *void) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFGetTypeID(cf: *void) -> usize;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFNumberGetTypeID() -> usize;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFStringGetTypeID() -> usize;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFDataGetTypeID() -> usize;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFNumberGetValue(number: *void, kind: i64, value: *mut i64) -> bool;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFStringCreateWithCString(allocator: *void, text: *CChar, encoding: u32) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFStringGetCString(text: *void, buffer: *mut u8, size: i64, encoding: u32) -> bool;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFDataGetBytePtr(data: *void) -> *u8;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFDataGetLength(data: *void) -> i64;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFDictionaryGetValue(dictionary: *void, key: *void) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopGetCurrent() -> *void;
    @cfg("USB_OS_MACOS")
    fn CFRunLoopRun();
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopAddSource(runLoop: *void, source: *void, mode: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopRemoveSource(runLoop: *void, source: *void, mode: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopWakeUp(runLoop: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopSourceCreate(allocator: *void, order: i64, context: *mut SourceContext) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFRunLoopSourceSignal(source: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn CFUUIDGetConstantUUIDWithBytes(
        allocator: *void,
        b0: u8, b1: u8, b2: u8, b3: u8, b4: u8, b5: u8, b6: u8, b7: u8,
        b8: u8, b9: u8, b10: u8, b11: u8, b12: u8, b13: u8, b14: u8, b15: u8,
    ) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn usb_cf_default_mode() -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn usb_iokit_pipe_async(
        iface: *mut void,
        pipe: u8,
        write: i32,
        buffer: *mut void,
        size: u32,
        callback: extern "C" fn(*mut void, i32, *mut void),
        refcon: *mut void,
    ) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn usb_iokit_abort_pipe(iface: *mut void, pipe: u8) -> i32;

    @cfg("USB_OS_MACOS")
    @effects()
    fn IOServiceMatching(name: *CChar) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IORegistryEntryIDMatching(id: u64) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOServiceGetMatchingServices(port: u32, matching: *void, iterator: *mut u32) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOServiceGetMatchingService(port: u32, matching: *void) -> u32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOIteratorNext(iterator: u32) -> u32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOObjectRelease(object: u32) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IORegistryEntryGetRegistryEntryID(entry: u32, id: *mut u64) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IORegistryEntryGetChildIterator(entry: u32, plane: *CChar, iterator: *mut u32) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IORegistryEntryCreateCFProperties(entry: u32, properties: *mut *void, allocator: *void, options: u32) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOObjectConformsTo(object: u32, className: *CChar) -> bool;
    @cfg("USB_OS_MACOS")
    fn IOCreatePlugInInterfaceForService(
        service: u32,
        pluginType: *void,
        interfaceType: *void,
        plugin: *mut *mut *mut PluginVtbl,
        score: *mut i32,
    ) -> i32;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IONotificationPortCreate(port: u32) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IONotificationPortDestroy(port: *void);
    @cfg("USB_OS_MACOS")
    @effects()
    fn IONotificationPortGetRunLoopSource(port: *void) -> *void;
    @cfg("USB_OS_MACOS")
    @effects()
    fn IOServiceAddMatchingNotification(
        port: *void,
        kind: *CChar,
        matching: *void,
        callback: extern "C" fn(*mut void, u32),
        refcon: *mut void,
        iterator: *mut u32,
    ) -> i32;
}

const UTF8: u32 = 0x08000100;
const NUMBER_SINT64: i64 = 4;

// IOReturn values (as i32).
const IO_SUCCESS: i32 = 0;
const IO_NO_RESOURCES: i32 = -536870210;         // 0xE00002BE
const IO_NOT_PRIVILEGED: i32 = -536870207;       // 0xE00002C1
const IO_NO_DEVICE: i32 = -536870208;            // 0xE00002C0
const IO_BAD_ARGUMENT: i32 = -536870206;         // 0xE00002C2
const IO_EXCLUSIVE_ACCESS: i32 = -536870203;     // 0xE00002C5
const IO_UNSUPPORTED: i32 = -536870201;          // 0xE00002C7
const IO_BUSY: i32 = -536870187;                 // 0xE00002D5
const IO_OFFLINE: i32 = -536870185;              // 0xE00002D7
const IO_NOT_ATTACHED: i32 = -536870183;         // 0xE00002D9
const IO_NOT_PERMITTED: i32 = -536870174;        // 0xE00002E2
const IO_UNDERRUN: i32 = -536870169;             // 0xE00002E7
const IO_TIMEOUT: i32 = -536870186;              // 0xE00002D6
const IO_ABORTED: i32 = -536870165;              // 0xE00002EB
const IO_NOT_FOUND: i32 = -536870160;            // 0xE00002F0
const USB_PIPE_STALLED: i32 = -536854449;        // 0xE000404F
const USB_TRANSACTION_TIMEOUT: i32 = -536854447; // 0xE0004051

/// CFUUIDBytes, passed by value to QueryInterface.
@repr(C)
struct UuidBytes {
    bytes: [u8; 16];
}

/// IOCFPlugInInterface's vtable, as far as used.
@repr(C)
struct PluginVtbl {
    reserved: *void;
    queryInterface: extern "C" fn(*mut void, UuidBytes, *mut *mut void) -> i32;
    addRef: extern "C" fn(*mut void) -> u32;
    release: extern "C" fn(*mut void) -> u32;
}

/// IOUSBDeviceInterface650's vtable (IOUSBLib.h), as far as used; the slots between are untyped.
@repr(C)
struct DeviceVtbl {
    reserved: *void;
    queryInterface: *void;
    addRef: *void;
    release: extern "C" fn(*mut void) -> u32;
    createDeviceAsyncEventSource: *void;
    getDeviceAsyncEventSource: *void;
    createDeviceAsyncPort: *void;
    getDeviceAsyncPort: *void;
    deviceOpen: extern "C" fn(*mut void) -> i32;
    deviceClose: extern "C" fn(*mut void) -> i32;
    v10: [*void; 8];
    getDeviceSpeed: extern "C" fn(*mut void, *mut u8) -> i32;
    getNumberOfConfigurations: extern "C" fn(*mut void, *mut u8) -> i32;
    getLocationID: *void;
    getConfigurationDescriptorPtr: extern "C" fn(*mut void, u8, *mut *mut u8) -> i32;
    getConfiguration: extern "C" fn(*mut void, *mut u8) -> i32;
    setConfiguration: extern "C" fn(*mut void, u8) -> i32;
    v24: [*void; 4];
    createInterfaceIterator: extern "C" fn(*mut void, *mut FindInterface, *mut u32) -> i32;
    deviceOpenSeize: *void;
    deviceRequestTO: extern "C" fn(*mut void, *mut DeviceRequest) -> i32;
    v31: [*void; 6];
    deviceReEnumerate: extern "C" fn(*mut void, u32) -> i32;
}

/// IOUSBInterfaceInterface700's vtable, as far as used.
@repr(C)
struct InterfaceVtbl {
    reserved: *void;
    queryInterface: *void;
    addRef: *void;
    release: extern "C" fn(*mut void) -> u32;
    createInterfaceAsyncEventSource: extern "C" fn(*mut void, *mut *void) -> i32;
    v5: [*void; 3];
    interfaceOpen: extern "C" fn(*mut void) -> i32;
    interfaceClose: extern "C" fn(*mut void) -> i32;
    v10: [*void; 7];
    getInterfaceNumber: extern "C" fn(*mut void, *mut u8) -> i32;
    getAlternateSetting: extern "C" fn(*mut void, *mut u8) -> i32;
    getNumEndpoints: extern "C" fn(*mut void, *mut u8) -> i32;
    v20: [*void; 2];
    setAlternateInterface: extern "C" fn(*mut void, u8) -> i32;
    v23: [*void; 3];
    getPipeProperties: extern "C" fn(*mut void, u8, *mut u8, *mut u8, *mut u8, *mut u16, *mut u8) -> i32;
    getPipeStatus: *void;
    abortPipe: extern "C" fn(*mut void, u8) -> i32;
    v29: [*void; 4];
    readPipeAsync: extern "C" fn(*mut void, u8, *mut void, u32, extern "C" fn(*mut void, i32, *mut void), *mut void) -> i32;
    writePipeAsync: extern "C" fn(*mut void, u8, *mut void, u32, extern "C" fn(*mut void, i32, *mut void), *mut void) -> i32;
    v35: [*void; 10];
    clearPipeStallBothEnds: extern "C" fn(*mut void, u8) -> i32;
}

/// IOUSBDevRequestTO
@repr(C)
struct DeviceRequest {
    requestType: u8;
    request: u8;
    value: u16;
    index: u16;
    length: u16;
    data: *mut u8;
    done: u32;
    noDataTimeout: u32;
    completionTimeout: u32;
}

/// IOUSBFindInterfaceRequest
@repr(C)
struct FindInterface {
    interfaceClass: u16;
    interfaceSubclass: u16;
    interfaceProtocol: u16;
    alternateSetting: u16;
}

/// CFRunLoopSourceContext (version 0).
@repr(C)
struct SourceContext {
    version: i64;
    info: *mut void;
    retain: *void;
    release: *void;
    copyDescription: *void;
    equal: *void;
    hash: *void;
    schedule: *void;
    cancel: *void;
    perform: extern "C" fn(*mut void);
}

