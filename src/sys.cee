// C library calls every POSIX backend uses, and the native helpers of src/platform/native.c. Linux-only and
// macOS-only calls are in their backends' files, each declared @cfg so other builds never see them.

extern "C" {
    @effects()
    fn usb_errno() -> i32;

    @cfg("target.unix")
    fn open(path: *CChar, flags: i32, ...) -> i32;
    @cfg("target.unix")
    @effects()
    fn close(fd: i32) -> i32;
    @cfg("target.unix")
    fn read(fd: i32, buffer: *mut u8, count: usize) -> isize;
    @cfg("target.unix")
    fn ioctl(fd: i32, request: CULong, ...) -> i32;
    @cfg("target.unix")
    @effects()
    fn mmap(address: *mut void, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> *mut void;
    @cfg("target.unix")
    @effects()
    fn munmap(address: *mut void, length: usize) -> i32;
    @cfg("target.unix")
    fn usleep(microseconds: u32) -> i32;
    @cfg("target.unix")
    @effects()
    fn sched_yield() -> i32;

    @cfg("target.windows")
    @effects()
    fn Sleep(milliseconds: u32);
    @cfg("target.windows")
    @effects()
    fn GetLastError() -> u32;
    @cfg("target.windows")
    @effects()
    fn CloseHandle(handle: *mut void) -> i32;
}

/// Sleeps this thread for `ms` milliseconds, for the rare waits that are not on a signal (draining an endpoint in
/// its drop, which must not need an executor).
/// Safety: plain C calls with values.
fn sleepMs(ms: u32) {
    if (cfg("target.windows")) {
        unsafe { Sleep(ms); }
    }
    if (cfg("target.unix")) {
        unsafe { usleep(ms * 1000); }
    }
}

/// The calling thread's last OS error: errno, or GetLastError on Windows.
/// Safety: reads a thread-local.
fn lastError() -> i32 {
    if (cfg("target.windows")) {
        return truncate<i32>(unsafe { GetLastError() });
    }
    return unsafe { usb_errno() };
}

/// Gives up the rest of this thread's time slice.
/// Safety: plain C calls.
fn yieldThread() {
    if (cfg("target.windows")) {
        unsafe { Sleep(0); }
    }
    if (cfg("target.unix")) {
        unsafe { sched_yield(); }
    }
}
